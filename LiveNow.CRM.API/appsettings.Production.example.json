{
  "AllowedHosts": "*",
  "DatabaseProvider": "sqlserver",
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_ConnectionStrings__DefaultConnection"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "SET_VIA_Jwt__Key",
    "Issuer": "SET_VIA_Jwt__Issuer",
    "Audience": "SET_VIA_Jwt__Audience",
    "ExpirationMinutes": 60
  },
  "BootstrapAdmin": {
    "Name": "SET_VIA_BootstrapAdmin__Name",
    "Username": "SET_VIA_BootstrapAdmin__Username",
    "Email": "SET_VIA_BootstrapAdmin__Email",
    "Password": "SET_VIA_BootstrapAdmin__Password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
