<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="LiveNow.CRM.Views.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Auditoría" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBox Width="180" Header="Desde" PlaceholderText="2026-09-01" Text="{x:Bind ViewModel.FromText, Mode=TwoWay}"/><TextBox Width="180" Header="Hasta" PlaceholderText="2026-09-30" Text="{x:Bind ViewModel.ToText, Mode=TwoWay}"/><TextBox Width="180" Header="Entidad" PlaceholderText="Payment" Text="{x:Bind ViewModel.EntityFilter, Mode=TwoWay}"/><ComboBox Width="180" Header="Acción" ItemsSource="{x:Bind ViewModel.Actions}" SelectedItem="{x:Bind ViewModel.ActionFilter, Mode=TwoWay}"/><Button Content="Filtrar" Click="Filter_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Logs}"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}"/><TextBlock Grid.Column="1" Text="{Binding EntityName}"/><TextBlock Grid.Column="2" Text="{Binding Action}"/><StackPanel Grid.Column="3"><TextBlock Text="{Binding OldValues}" Opacity="0.7" TextWrapping="Wrap"/><TextBlock Text="{Binding NewValues}" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
</Page>
