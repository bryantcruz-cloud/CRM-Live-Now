<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="LiveNow.CRM.Views.CancellationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Cancelaciones y transferencias" FontSize="28" FontWeight="SemiBold" />
        <Grid Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Registrar cancelación" FontWeight="SemiBold"/><ComboBox x:Name="CancellationCustomer" Header="Cliente" ItemsSource="{x:Bind ViewModel.Customers}" SelectedItem="{x:Bind ViewModel.SelectedCancellationCustomer, Mode=TwoWay}" DisplayMemberPath="DisplayName" SelectionChanged="CancellationCustomer_Changed"/><ComboBox x:Name="CancellationSale" Header="Venta (opcional)" ItemsSource="{x:Bind ViewModel.FilteredSales}" SelectedItem="{x:Bind ViewModel.SelectedCancellationSale, Mode=TwoWay}" DisplayMemberPath="DisplayName" SelectionChanged="CancellationSale_Changed"/><ComboBox x:Name="CancellationSlot" Header="Plaza (opcional)" ItemsSource="{x:Bind ViewModel.FilteredSlots}" SelectedItem="{x:Bind ViewModel.SelectedCancellationSlot, Mode=TwoWay}" DisplayMemberPath="DisplayName"/><TextBox x:Name="CancellationReason" Header="Motivo"/><CheckBox x:Name="CancellationInjury" Content="Lesión"/><CheckBox x:Name="CancellationReassign" Content="Dejar plaza transferible"/><Button Content="Registrar" Click="Cancel_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Transferir plaza" FontWeight="SemiBold"/><ComboBox x:Name="TransferSlot" Header="Plaza origen" ItemsSource="{x:Bind ViewModel.TransferableSlots}" SelectedItem="{x:Bind ViewModel.SelectedTransferSlot, Mode=TwoWay}" DisplayMemberPath="DisplayName"/><ComboBox x:Name="TransferCustomer" Header="Cliente destino" ItemsSource="{x:Bind ViewModel.Customers}" SelectedItem="{x:Bind ViewModel.SelectedTransferCustomer, Mode=TwoWay}" DisplayMemberPath="DisplayName"/><TextBox x:Name="TransferReason" Header="Motivo"/><Button Content="Transferir" Click="Transfer_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListView ItemsSource="{x:Bind ViewModel.Cancellations}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6"><TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}"/><TextBlock Text="{Binding SlotCode}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PreviousSlotStatus}"/><TextBlock Text=" → "/><TextBlock Text="{Binding NewSlotStatus}"/></StackPanel><TextBlock Text="{Binding CancellationDate}" Opacity="0.7"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.Transfers}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6"><TextBlock Text="{Binding SlotCode}" FontWeight="SemiBold"/><TextBlock Text="{Binding FromCustomerId}"/><TextBlock Text="→ {Binding ToCustomerId}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PreviousSlotStatus}"/><TextBlock Text=" → "/><TextBlock Text="{Binding NewSlotStatus}"/></StackPanel><TextBlock Text="{Binding Reason}" Opacity="0.7"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid>
    </Grid>
</Page>
