<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="LiveNow.CRM.Views.HotelsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Hoteles y reservas" FontSize="28" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Editar hotel" Click="EditHotel_Click" Margin="8,0"/><Button Grid.Column="2" Content="Nuevo hotel" Click="NewHotel_Click" Margin="8,0"/><Button Grid.Column="3" Content="Editar reserva" Click="EditReservation_Click" Margin="8,0"/><Button Grid.Column="4" Content="Nueva reserva" Click="NewReservation_Click" Style="{StaticResource AccentButtonStyle}"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.Hotels}" SelectedItem="{x:Bind SelectedHotel, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding City}"/><TextBlock Text="{Binding IsActive}" Opacity="0.7"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
   <ListView Grid.Column="1" Margin="16,0,0,0" ItemsSource="{x:Bind ViewModel.Reservations}" SelectedItem="{x:Bind SelectedReservation, Mode=TwoWay}"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding HotelName}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}"/><TextBlock Text="{Binding SaleNumber}"/><TextBlock Text="{Binding SupplierName}"/><TextBlock Text="{Binding RoomType}"/><TextBlock Text="{Binding CheckIn}"/><TextBlock Text="{Binding CheckOut}"/><TextBlock Text="{Binding Status}" Opacity="0.7"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SalePrice}" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
  </Grid>
 </Grid>
</Page>
