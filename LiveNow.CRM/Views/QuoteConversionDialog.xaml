<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LiveNow.CRM.Views.QuoteConversionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Convertir cotización a venta"
    PrimaryButtonText="Convertir"
    CloseButtonText="Cancelar">
    <StackPanel Spacing="8">
        <TextBlock x:Name="CustomerText" />
        <TextBlock x:Name="QuoteText" />
        <TextBlock x:Name="TotalText" />
        <TextBlock Text="Plazas disponibles" />
        <ListView x:Name="SlotsListView" SelectionMode="Multiple" Height="220" />
    </StackPanel>
</ContentDialog>

