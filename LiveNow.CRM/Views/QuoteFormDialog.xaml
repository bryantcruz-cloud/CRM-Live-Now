<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LiveNow.CRM.Views.QuoteFormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Nueva cotización"
    PrimaryButtonText="Guardar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="12" Padding="0,8,0,0">
            <InfoBar x:Name="ValidationInfoBar" IsOpen="False" Severity="Error" Title="Error de validación" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="0"
                    x:Name="CustomerComboBox"
                    Header="Cliente *"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,4,0"
                    PlaceholderText="Seleccione cliente" />
                <ComboBox
                    Grid.Column="1"
                    x:Name="CurrencyComboBox"
                    Header="Moneda"
                    HorizontalAlignment="Stretch"
                    Margin="4,0,0,0" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="0"
                    x:Name="RaceComboBox"
                    Header="Carrera"
                    DisplayMemberPath="Name"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,4,0"
                    PlaceholderText="Seleccione carrera" />
                <ComboBox
                    Grid.Column="1"
                    x:Name="EditionComboBox"
                    Header="Edición"
                    DisplayMemberPath="Year"
                    HorizontalAlignment="Stretch"
                    Margin="4,0,0,0"
                    PlaceholderText="Seleccione edición" />
            </Grid>
            <DatePicker x:Name="ValidUntilDatePicker" Header="Válida hasta" />
            <TextBox x:Name="NotesTextBoxHeader" Header="Notas" PlaceholderText="Notas adicionales" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

            <!-- Items section -->
            <TextBlock Text="Items" FontWeight="SemiBold" FontSize="16" />
            <Button Content="+ Agregar item" Click="AddItemButton_Click" />
            <StackPanel x:Name="ItemsPanel" Spacing="8" />

            <!-- Totals -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock FontSize="14">
                        <Run Text="Subtotal: " /><Run Text="{x:Bind SubtotalText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="14">
                        <Run Text="Descuento: " /><Run Text="{x:Bind DiscountText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="14">
                        <Run Text="Impuestos: " /><Run Text="{x:Bind TaxesText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                        <Run Text="Total: " /><Run Text="{x:Bind TotalText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
