<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiveNow.CRM.Views.QuotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Cotizaciones"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="Nueva cotización"
                Click="NewQuoteButton_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- Filters and search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                PlaceholderText="Buscar por número de cotización..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="SearchBox_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <ComboBox
                Grid.Column="1"
                Header="Estado"
                ItemsSource="{x:Bind ViewModel.StatusFilterOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                Margin="8,0,0,0"
                MinWidth="150"
                PlaceholderText="Todos" />
            <Button
                Grid.Column="2"
                Content="Actualizar"
                Margin="8,0,0,0"
                Click="RefreshButton_Click"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Error message -->
        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Margin="0,0,0,12"
            CloseButtonClick="InfoBar_CloseButtonClick" />

        <!-- Success message -->
        <InfoBar
            Grid.Row="2"
            x:Name="SuccessInfoBar"
            IsOpen="False"
            Severity="Success"
            Title="Operación exitosa"
            Message="{x:Bind SuccessMessage, Mode=OneWay}"
            Margin="0,0,0,12" />

        <!-- Loading -->
        <ProgressRing
            Grid.Row="4"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="50" Height="50" />

        <!-- Quotes list -->
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Quotes, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedQuote, Mode=TwoWay}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="QuotesList_ItemClick"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" FontSize="16">
                                <Run Text="#" /><Run Text="{Binding QuoteNumber}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <TextBlock FontSize="12" Opacity="0.6">
                                    <Run Text="Estado: " /><Run Text="{Binding Status}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Opacity="0.6">
                                    <Run Text="Moneda: " /><Run Text="{Binding Currency}" />
                                </TextBlock>
                                <TextBlock FontSize="12" Opacity="0.6">
                                    <Run Text="Total: " /><Run Text="{Binding Total}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.5" Margin="0,2,0,0">
                                <Run Text="Vence: " /><Run Text="{Binding ValidUntil}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Ver" Tag="{Binding Id}" Click="ViewButton_Click" />
                            <Button Content="Editar" Tag="{Binding Id}" Click="EditButton_Click" />
                            <Button Content="Enviar" Tag="{Binding Id}" Click="SendButton_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Pagination -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="{x:Bind ViewModel.PageInfo, Mode=OneWay}"
                VerticalAlignment="Center"
                Opacity="0.7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Content="⏮" Click="FirstPageButton_Click" IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}" ToolTipService.ToolTip="Primera página" />
                <Button Content="◀" Click="PreviousPageButton_Click" IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}" ToolTipService.ToolTip="Página anterior" />
                <Button Content="▶" Click="NextPageButton_Click" IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}" ToolTipService.ToolTip="Página siguiente" />
                <Button Content="⏭" Click="LastPageButton_Click" IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}" ToolTipService.ToolTip="Última página" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
