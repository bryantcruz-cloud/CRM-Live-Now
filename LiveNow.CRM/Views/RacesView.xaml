<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiveNow.CRM.Views.RacesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Carreras"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="Actualizar"
                Click="RefreshButton_Click"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Search bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                PlaceholderText="Buscar por nombre, ciudad, país o tipo..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center">
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="SearchBox_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
            <Button
                Grid.Column="1"
                Content="Buscar"
                Margin="8,0,0,0"
                Click="SearchButton_Click"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Error message -->
        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Margin="0,0,0,12"
            CloseButtonClick="InfoBar_CloseButtonClick" />

        <!-- Loading -->
        <ProgressRing
            Grid.Row="3"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="50" Height="50" />

        <!-- Content -->
        <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Races list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Text="Carreras"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8" />

                <!-- Empty state -->
                <TextBlock
                    Grid.Row="1"
                    Text="No se encontraron carreras"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Visibility="{x:Bind ViewModel.HasRaces, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Races, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedRace, Mode=TwoWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="{Binding Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="Tipo: " /><Run Text="{Binding RaceType}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="Estado: " /><Run Text="{Binding Status}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Opacity="0.5" Margin="0,2,0,0">
                                        <Run Text="{Binding City}" /><Run Text=", " /><Run Text="{Binding Country}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Editions panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Text="Ediciones"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8" />

                <!-- No race selected -->
                <TextBlock
                    Grid.Row="1"
                    Text="Seleccione una carrera para ver sus ediciones"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Visibility="{x:Bind ViewModel.SelectedRace, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

                <!-- Editions loading -->
                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind ViewModel.IsEditionsLoading, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="40" Height="40" />

                <!-- Editions empty -->
                <TextBlock
                    Grid.Row="1"
                    Text="Esta carrera no tiene ediciones"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Visibility="{x:Bind ViewModel.HasEditions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Editions, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasEditions, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="16">
                                        <Run Text="Edición " /><Run Text="{Binding Year}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="Fecha: " /><Run Text="{Binding RaceDate}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="Estado: " /><Run Text="{Binding Status}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Opacity="0.5" Margin="0,2,0,0" Text="{Binding Notes}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
